# Copy to deploy/.env — read automatically by `docker compose`. Never commit deploy/.env.

# Postgres password used by both the postgres service and the API connection string
POSTGRES_PASSWORD=myfrete

# Distance/route provider key (Google Distance Matrix or Mapbox). Empty => geodesic fallback.
ROUTE_PROVIDER_API_KEY=

# JWT signing key (dev only — inject from a secret manager in staging/production)
JWT_SIGNING_KEY=dev-only-change-me-0123456789abcdef0123456789abcdef
