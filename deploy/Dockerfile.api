# syntax=docker/dockerfile:1
# Docker-first (Constitution §VIII): this image is the unit of build/run/deploy for the API.
# Same image in dev (Compose), CI, staging and production — only config/secrets differ.

FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src
COPY api/ ./api/
WORKDIR /src/api
RUN dotnet restore MyFrete.sln
RUN dotnet publish src/MyFrete.Api/MyFrete.Api.csproj -c Release -o /app --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:9.0 AS runtime
# curl is used by the container HEALTHCHECK / Compose healthcheck against /ready
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /app ./
EXPOSE 8080
ENV ASPNETCORE_URLS=http://+:8080
USER $APP_UID
HEALTHCHECK --interval=10s --timeout=3s --start-period=20s --retries=12 \
    CMD curl -fsS http://localhost:8080/ready || exit 1
ENTRYPOINT ["dotnet", "MyFrete.Api.dll"]
