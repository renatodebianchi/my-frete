{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=myfrete;Username=myfrete;Password=myfrete",
    "Redis": "localhost:6379"
  },
  "Otlp": {
    "Endpoint": "http://localhost:4317"
  },
  "Jwt": {
    "Issuer": "my-frete",
    "Audience": "my-frete-app",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "AllowedHosts": "*"
}
