root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
trim_trailing_whitespace = true

[*.{cs,csx}]
indent_size = 4
dotnet_sort_system_directives_first = true
csharp_new_line_before_open_brace = all
csharp_style_namespace_declarations = file_scoped:warning
dotnet_style_qualification_for_field = false:warning
dotnet_diagnostic.CA1848.severity = none
dotnet_diagnostic.CA2007.severity = none
# Single-language (C#) codebase: cross-language keyword-collision rule is not relevant
dotnet_diagnostic.CA1716.severity = none
# Parameter-name-must-match-base: noisy for MediatR handlers, no runtime effect
dotnet_diagnostic.CA1725.severity = none

[*.{json,yml,yaml,csproj,props,targets}]
indent_size = 2

# Test method names conventionally use underscores
[tests/**/*.cs]
dotnet_diagnostic.CA1707.severity = none

# EF Core-generated migrations
[**/Migrations/*.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none
